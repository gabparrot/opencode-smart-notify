{
  "name": "opencode-smart-notify",
  "version": "0.2.0",
  "description": "Desktop notifications for OpenCode that stay quiet when auto-approve handles the request",
  "type": "module",
  "license": "MIT",
  "author": "Gabriel Parrot",
  "homepage": "https://github.com/gabparrot/opencode-smart-notify",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabparrot/opencode-smart-notify.git"
  },
  "bugs": {
    "url": "https://github.com/gabparrot/opencode-smart-notify/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "notifications",
    "notify-send",
    "libnotify",
    "linux",
    "macos",
    "windows",
    "desktop"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run typecheck && bun test"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "*",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "opencode": {
    "name": "opencode-smart-notify",
    "displayName": "OpenCode Smart Notify",
    "description": "Notify on permission requests, questions, errors, and when an agent finishes. Skip requests that auto-approve.",
    "entry": "src/index.ts"
  }
}
